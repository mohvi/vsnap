{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/entry/:challengeId/:entryId",
      "destination": "/api/share?type=entry&c=:challengeId&e=:entryId"
    },
    {
      "source": "/challenge/:challengeId",
      "destination": "/api/share?type=challenge&c=:challengeId"
    },
    {
      "source": "/invite/:code",
      "destination": "/api/share?type=invite&code=:code"
    },
    {
      "source": "/((?!\\.well-known/|api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/challenge-action.js": {
      "maxDuration": 60
    }
  }
}
